NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace_with_your_password
DB_NAME_TEST=sdn_test
# Hosted databases always use verified TLS. Supabase hosts use the included public CA.
# Optional override: set this to your provider's trusted CA file when needed.
# On Render, a Secret File can be mounted at /etc/secrets/prod-ca-2021.crt.
DB_SSL_CA_FILE=
SESSION_SECRET=replace_with_a_random_string_of_at_least_32_characters
